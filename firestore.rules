rules_version = '2';

// Reglas de seguridad del Sistema Slavon (todas las apps comparten esta base).
// Pegar en la consola de Firebase → Firestore Database → Reglas → Publicar.
// Los permisos se imponen acá, no sólo en la pantalla: nadie puede saltearlos yendo directo a la base.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == 'juanmarcospaterno@gmail.com'; }
    function userDoc() { return /databases/$(database)/documents/users/$(myEmail()); }
    function profile() { return get(userDoc()).data; }
    function isActive() { return signedIn() && exists(userDoc()) && profile().get('activo', false) == true; }
    // Puede dar de alta usuarios y cambiar permisos.
    function isSuper() { return isOwner() || (isActive() && profile().get('super', false) == true); }
    // Permiso de la persona en una app: 'admin', 'encargado' o '' (sin acceso).
    function role(app) { return isOwner() ? 'admin' : (isActive() ? profile().get('apps', {}).get(app, '') : ''); }

    /* ---------- Usuarios ---------- */
    match /users/{email} {
      // Cada uno lee su propio usuario. Los que manejan usuarios y los admin de alguna app ven la lista
      // (para elegir encargados de obra, etc.).
      allow read: if (signedIn() && email == myEmail())
        || isSuper()
        || role('obras') in ['admin', 'administrativo', 'encargado'] || role('deposito') == 'admin';
      allow create, update: if isSuper() && email == email.lower()
        && request.resource.data.keys().hasOnly(['nombre', 'apps', 'super', 'activo', 'editadoPor', 'editadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.apps is map
        && request.resource.data.super is bool
        && request.resource.data.activo is bool;
      allow delete: if isOwner();
    }

    /* ---------- Obras ---------- */
    // admin: todo · administrativo: ventas y cobros (todo menos eliminar) · encargado: entrega e instalación.
    function obrasAdmin() { return role('obras') == 'admin'; }
    function obrasGestion() { return role('obras') in ['admin', 'administrativo']; }
    function obrasMember() { return role('obras') in ['admin', 'administrativo', 'encargado']; }

    match /obras/{id} {
      allow read: if obrasMember();
      allow create: if obrasGestion();
      allow delete: if obrasAdmin();
      // El encargado de obra sólo toca lo de la entrega y la instalación (queda registrado quién).
      allow update: if obrasGestion()
        || (obrasMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'etapas', 'checklist', 'logistica', 'incidencias', 'instInicio', 'instFin', 'equipo', 'responsable', 'flete',
            'estado', 'fin', 'postventa', 'editadoPor', 'editadoPorNombre', 'editadoEn'])
          // puede marcar la obra como entregada, pero no habilitar una venta
          && (!('estado' in request.resource.data.diff(resource.data).affectedKeys())
            || (resource.data.estado == 'en_curso' && request.resource.data.estado == 'terminada'))
          && request.resource.data.editadoPor == myEmail());
    }

    // Plata de cada venta (precio, seña, forma de pago, saldo, contrato): sólo admin y administrativo.
    match /ventas/{id} {
      allow read, create, update: if obrasGestion();
      allow delete: if obrasAdmin();
    }

    // Cobros de cada venta (parciales o totales, en dólares o pesos): sólo admin y administrativo.
    // Un pago no se edita: si estuvo mal se anula (queda registrado quién y por qué). Borrar sólo admin.
    match /pagos/{id} {
      allow read: if obrasGestion();
      allow create: if obrasGestion()
        && request.resource.data.por == myEmail()
        && request.resource.data.obraId is string
        && request.resource.data.monto is number && request.resource.data.monto > 0
        && request.resource.data.moneda in ['USD', 'ARS'];
      allow update: if obrasGestion()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulado', 'anuladoPor', 'anuladoPorNombre', 'anuladoFecha', 'anuladoMotivo'])
        && request.resource.data.anuladoPor == myEmail();
      allow delete: if obrasAdmin();
    }

    // Fotos de la obra y planos adjuntos en la venta (tipo «plano»).
    match /fotos/{id} {
      allow read: if obrasMember();
      allow create: if obrasMember()
        && request.resource.data.por == myEmail()
        && request.resource.data.obraId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow delete: if obrasAdmin() || (obrasMember() && resource.data.por == myEmail())
        || (obrasGestion() && resource.data.get('tipo', '') == 'plano');
      allow update: if false;
    }

    // Configuración de Obras (equipos de instalación).
    match /config/obras {
      allow read: if obrasMember();
      allow write: if obrasGestion();
    }

    // Lo que no está listado arriba (Administración, Depósito, Personal) queda cerrado hasta que se armen esas apps.
  }
}
